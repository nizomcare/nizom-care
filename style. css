:root{--bg:#f3f9fc;--card:#fff;--ink:#0b2545;--mut:#5b7186;--pri:#0e9aa7;--pri2:#13315c;--soft:#e0f3f6;--bd:#d5e6ee;--bad:#c0392b;--ok:#1e8e5a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#081426;--card:#0f2340;--ink:#e8f2fa;--mut:#93a9bd;--pri:#2cc4d1;--pri2:#9fd8ff;--soft:#12304f;--bd:#1d3a5c}}
:root[data-theme=dark]{--bg:#081426;--card:#0f2340;--ink:#e8f2fa;--mut:#93a9bd;--pri:#2cc4d1;--pri2:#9fd8ff;--soft:#12304f;--bd:#1d3a5c}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 "Segoe UI",system-ui,sans-serif}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--card);border-bottom:1px solid var(--bd)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--card);z-index:10}
.logo{font-weight:700;font-size:20px;color:var(--pri2);flex:1}.logo b{color:var(--pri)}
button,select,input{font:inherit;color:inherit}
.ib{border:1px solid var(--bd);background:var(--soft);border-radius:14px;min-width:44px;height:44px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:4px;padding:0 10px}
.burger{flex-direction:column;gap:5px}.burger i{display:block;width:20px;height:2px;background:var(--pri2);border-radius:2px}
.arrow{transition:transform .3s;display:inline-block}.open .arrow{transform:rotate(180deg)}
nav{max-height:0;overflow:hidden;transition:max-height .35s ease;background:var(--card);border-bottom:1px solid var(--bd)}
.open nav{max-height:1500px}
nav button{display:block;width:100%;text-align:left;background:none;border:0;padding:12px 18px;cursor:pointer;border-bottom:1px solid var(--bd)}
nav button.on{background:var(--soft);color:var(--pri2);font-weight:600}
main{max-width:900px;margin:0 auto;padding:16px 14px 90px}
h1{font-size:24px;margin:4px 0 12px}h2{font-size:18px;margin:18px 0 8px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:14px;margin-bottom:12px}
.hero{background:linear-gradient(135deg,var(--pri2),var(--pri));color:#fff;border:0}
.hero input{width:100%;margin-top:10px;padding:12px 14px;border-radius:14px;border:0;color:#0b2545}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.sp{justify-content:space-between}
.days{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;text-align:center}
.d{border:1px solid var(--bd);background:var(--card);border-radius:12px;padding:8px 0;cursor:pointer;min-height:44px}
.d.sel{background:var(--pri);color:#fff;border-color:var(--pri)}.d.today{outline:2px solid var(--pri2)}.d.x{visibility:hidden}
.slot{border:1px solid var(--pri);background:var(--card);color:var(--pri2);border-radius:12px;padding:10px 14px;cursor:pointer}
.slot.busy{border-color:var(--bd);color:var(--mut);background:var(--soft);cursor:not-allowed;text-decoration:line-through}
.slot.sel{background:var(--pri);color:#fff}
.btn{background:var(--pri);color:#fff;border:0;border-radius:14px;padding:12px 18px;cursor:pointer;font-weight:600}
.btn.g{background:var(--soft);color:var(--pri2)}.btn.r{background:var(--bad)}
.pill{display:inline-block;border-radius:99px;padding:2px 10px;font-size:14px;background:var(--soft);color:var(--pri2)}
.av{width:48px;height:48px;border-radius:50%;background:var(--pri);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;flex:none}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.stat{font-size:28px;font-weight:700;color:var(--pri)}
input.f,select.f{width:100%;padding:12px;border-radius:12px;border:1px solid var(--bd);background:var(--bg);margin:4px 0 10px}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--pri2);color:#fff;padding:12px 18px;border-radius:14px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:20;max-width:90%}
#toast.show{opacity:1}#toast.err{background:var(--bad)}
.bar{height:10px;border-radius:6px;background:var(--soft);overflow:hidden}.bar i{display:block;height:100%;background:var(--pri)}
.tbl{overflow-x:auto}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
:focus-visible{outline:3px solid var(--pri2);outline-offset:2px}
.me{background:var(--soft);border-radius:14px;padding:8px 12px;margin:6px 0 6px 20%}.big{font-size:44px;font-weight:700;color:var(--pri);line-height:1.1}.qrb svg{width:170px;height:170px}.warn{border-color:var(--bad)}.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:14px 0}.tile{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:18px 10px;min-height:96px;font-weight:600;font-size:18px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center}.tile span{font-size:32px}
